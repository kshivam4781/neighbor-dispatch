# Copy this file to .env and fill in ONE provider's values. Leave MODEL_PROVIDER=mock (or unset) to run
# fully offline with the deterministic fallback extractor -- no key needed, this is the default demo mode.
MODEL_PROVIDER=mock

# --- Anthropic ---
# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_ID=claude-sonnet-4-6

# --- OpenAI ---
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL_ID=gpt-4o

# --- Amazon Bedrock (uses your local AWS credentials/region, not an API key here) ---
# MODEL_PROVIDER=bedrock
# BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=1024
